{
  "name": "Observatoire Maroc - Clair",
  "dataColors": ["#2A9DB0", "#9ED3DE", "#E8836B", "#1B6F7E", "#2E9E5B", "#F2B84B", "#7A8CA3", "#C9D3DA"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#2A9DB0",
  "good": "#2E9E5B",
  "neutral": "#F2B84B",
  "bad": "#D64545",
  "maximum": "#1B6F7E",
  "center": "#9ED3DE",
  "minimum": "#EEF8FB",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2A37" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A37" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F2A37" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5B6675" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "radius": 14 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#9FB8C8" } }, "position": "Outer", "preset": "Center", "transparency": 70 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2A37" } }, "fontSize": 11, "bold": true, "fontFamily": "Segoe UI Semibold" }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#DCEFF6" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EAF6FA" } }, "transparency": 0 }]
      }
    }
  }
}
